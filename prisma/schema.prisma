generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
}

model Category {
  id       String    @id @default(cuid())
  name     String
  products Product[]
}

model Product {
  id          String      @id @default(cuid())
  name        String
  description String?
  price       Float
  unit        String      // kg, packet, dozen, litre etc.
  stock       Int         @default(0)
  imageUrl    String?
  categoryId  String
  category    Category    @relation(fields: [categoryId], references: [id])
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  orderItems  OrderItem[]
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  COD
}

enum PaymentStatus {
  UNPAID
  PAID
}

// A guest order placed through the storefront checkout.
model Order {
  id            String        @id @default(cuid()) // unguessable; used as the confirmation page token
  orderNumber   Int           @default(autoincrement()) // customer-facing number
  customerName  String
  phone         String
  email         String?
  address       String
  city          String
  notes         String?
  status        OrderStatus   @default(PENDING)
  paymentMethod PaymentMethod @default(COD)
  paymentStatus PaymentStatus @default(UNPAID)
  subtotal      Float
  shippingFee   Float         @default(0)
  total         Float
  items         OrderItem[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([phone])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  name      String  // snapshot of the product name at time of order
  unit      String  // snapshot of the product unit at time of order
  price     Float   // snapshot of the unit price at time of order
  quantity  Int
  total     Float
}

// Singleton row (fixed id "store") holding the public-facing store profile.
model StoreSettings {
  id                    String   @id @default("store")
  name                  String   @default("Rust N Riches")
  logoUrl               String?
  address               String?
  phone                 String?
  email                 String?
  whatsapp              String?
  shippingFee           Float    @default(0)
  freeShippingThreshold Float?
  updatedAt             DateTime @updatedAt
}
